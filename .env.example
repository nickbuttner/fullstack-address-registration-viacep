# Copie para .env e altere os valores.
# O arquivo .env não deve ser versionado.

DB_NAME=projectdb
DB_USERNAME=postgres
DB_PASSWORD=altere-a-senha-do-banco
DB_HOST=localhost
DB_PORT=5432

# Gere com: openssl rand -hex 48  (mínimo 32 caracteres)
JWT_SECRET=substitua-por-uma-chave-aleatoria-de-no-minimo-32-caracteres
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# 8+ caracteres, 1 maiúscula, 1 minúscula, 1 número e 1 especial
SEED_ADMIN_PASSWORD=AltereEstaSenha@1
SEED_USER_PASSWORD=AltereEstaSenha@2
